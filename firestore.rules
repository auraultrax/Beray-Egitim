rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return signedIn() && myProfile().role in ['teacher', 'admin'];
    }

    function isAdmin() {
      return signedIn() && myProfile().role == 'admin';
    }

    function ownsTeacherRecord() {
      return signedIn() && (isAdmin() || resource.data.teacherId == request.auth.uid);
    }

    // User profile and points are server-managed. Clients may only read their own profile;
    // teachers/admins can list profiles for classroom administration.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isTeacher());
      allow list: if isTeacher();
      allow create, update, delete: if false;
    }

    // Usernames are reserved exclusively by Cloud Functions in an atomic transaction.
    match /usernameIndex/{username} {
      allow read, write: if false;
    }

    // Never expose answer keys to a browser. The Admin SDK in Cloud Functions bypasses rules.
    match /testAnswerKeys/{testId} {
      allow read, write: if false;
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if ownsTeacherRecord();
      allow delete: if false;
    }

    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if ownsTeacherRecord();
      allow delete: if false;
    }

    match /tests/{testId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /results/{resultId} {
      allow get: if signedIn() && (resource.data.studentId == request.auth.uid || resource.data.userId == request.auth.uid || isTeacher());
      allow list: if isTeacher() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if ownsTeacherRecord();
    }

    match /meetings/{meetingId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if ownsTeacherRecord();
    }

    match /notifications/{notificationId} {
      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Follow state, point transfers and friendship documents are mutated through validated
    // Cloud Functions transactions only; students cannot forge requests or mint points.
    match /friendships/{friendshipId} {
      allow read, write: if false;
    }
    match /followRequests/{requestId} {
      allow read, write: if false;
    }
    match /pointTransfers/{transferId} {
      allow read, write: if false;
    }

    // No document is public unless a rule above explicitly permits it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
